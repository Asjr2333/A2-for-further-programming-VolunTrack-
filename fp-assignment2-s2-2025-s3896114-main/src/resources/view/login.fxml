<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER" spacing="20" style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="8" maxWidth="400">
        <Label text="VolunTrack" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Label text="Volunteer Management System" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
    </VBox>

    <VBox spacing="15" maxWidth="400" style="-fx-background-color: white; -fx-background-radius: 12;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <VBox spacing="8">
            <Label text="Username" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;"/>
            <TextField fx:id="usernameField" promptText="Enter your username"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;
                              -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Password" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;
                                 -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>

        <Label fx:id="messageLabel" style="-fx-font-size: 13px; -fx-font-weight: 500;" wrapText="true"/>

        <Button fx:id="loginButton" text="Login" maxWidth="Infinity"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
            <Hyperlink fx:id="signupLink" text="Sign up"
                       style="-fx-font-size: 13px; -fx-text-fill: #3b82f6; -fx-font-weight: 600;"/>
        </HBox>
    </VBox>
</VBox>