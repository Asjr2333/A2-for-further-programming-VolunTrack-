<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f8fafc;">

    <top>
        <VBox spacing="15" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" HBox.hgrow="ALWAYS"/>
                <Button fx:id="logoutButton" text="Logout"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Project Management" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addProjectButton" text="Add Project"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 10 18 10 18; -fx-cursor: hand;"/>
                <Button fx:id="modifyProjectButton" text="Modify Project"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 10 18 10 18; -fx-cursor: hand;"/>
                <Button fx:id="toggleStatusButton" text="Enable/Disable"
                        style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 10 18 10 18; -fx-cursor: hand;"/>
                <Button fx:id="viewAllRegistrationsButton" text="View All Registrations"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 10 18 10 18; -fx-cursor: hand;"/>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <TableView fx:id="projectTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" text="Project Title" prefWidth="160"/>
                        <TableColumn fx:id="locationColumn" text="Location" prefWidth="140"/>
                        <TableColumn fx:id="dayColumn" text="Day" prefWidth="80"/>
                        <TableColumn fx:id="hourlyValueColumn" text="Hourly Value ($)" prefWidth="120"/>
                        <TableColumn fx:id="registeredSlotsColumn" text="Registered" prefWidth="100"/>
                        <TableColumn fx:id="totalSlotsColumn" text="Total Slots" prefWidth="100"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>