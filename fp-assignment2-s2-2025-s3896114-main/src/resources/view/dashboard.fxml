<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f8fafc;">

    <top>
        <VBox spacing="15" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" HBox.hgrow="ALWAYS"/>
                <Button fx:id="viewHistoryButton" text="View History"
                        style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                <Button fx:id="changePasswordButton" text="Change Password"
                        style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                <Button fx:id="logoutButton" text="Logout"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <VBox spacing="15" HBox.hgrow="ALWAYS">
                <Label text="Available Projects" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <TableView fx:id="projectTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="titleColumn" text="Project Title" prefWidth="180"/>
                            <TableColumn fx:id="locationColumn" text="Location" prefWidth="130"/>
                            <TableColumn fx:id="dayColumn" text="Day" prefWidth="80"/>
                            <TableColumn fx:id="hourlyValueColumn" text="Value ($)" prefWidth="90"/>
                            <TableColumn fx:id="availableSlotsColumn" text="Available" prefWidth="90"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER">
                        <padding>
                            <Insets top="15"/>
                        </padding>
                        <Button fx:id="addToCartButton" text="Add to Cart"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="15" prefWidth="350" minWidth="350">
                <Label text="Registration Cart" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <ListView fx:id="cartListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: transparent;"/>

                    <HBox alignment="CENTER" spacing="10">
                        <padding>
                            <Insets top="15"/>
                        </padding>
                        <Label fx:id="cartTotalLabel" text="Total: $0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <padding>
                            <Insets top="10"/>
                        </padding>
                        <Button fx:id="removeFromCartButton" text="Remove"
                                style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                        <Button fx:id="confirmButton" text="Confirm Registration"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px;
                                       -fx-font-weight: 600; -fx-background-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>