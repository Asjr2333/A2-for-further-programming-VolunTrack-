<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <VBox alignment="CENTER" maxWidth="400" spacing="8">
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Create Account" />
        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Join VolunTrack today" />
    </VBox>

    <VBox maxWidth="400" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12;                                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets bottom="25" left="30" right="30" top="25" />
        </padding>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;" text="Full Name" />
            <TextField fx:id="fullNameField" promptText="Enter your full name" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;                               -fx-padding: 10; -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;" text="Username" />
            <TextField fx:id="usernameField" promptText="Choose a username" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;                               -fx-padding: 10; -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;" text="Email" />
            <TextField fx:id="emailField" promptText="Enter your email" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;                               -fx-padding: 10; -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Create a password" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;                                  -fx-padding: 10; -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #475569;" text="Confirm Password" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;                                  -fx-padding: 10; -fx-font-size: 14px;" />
        </VBox>

        <Label fx:id="messageLabel" prefHeight="63.0" prefWidth="187.0" style="-fx-font-size: 12px; -fx-font-weight: 500;" wrapText="true" />

        <Button fx:id="signupButton" maxWidth="Infinity" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14px;                        -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" text="Sign Up">
            <VBox.margin>
                <Insets top="5" />
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Already have an account?" />
            <Hyperlink fx:id="loginLink" style="-fx-font-size: 13px; -fx-text-fill: #3b82f6; -fx-font-weight: 600;" text="Login" />
        </HBox>
    </VBox>
</VBox>
